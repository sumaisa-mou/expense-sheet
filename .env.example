# --- Google OAuth client (Google Cloud Console > Credentials) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Local dev: http://localhost:3000
# Production: https://<your-app>.vercel.app
AUTH_URL=http://localhost:3000

# --- Access control ---
# Comma-separated allowlist. Anyone not listed is refused after Google sign-in.
# Leave empty to allow any account that gets past Google's consent screen.
ALLOWED_EMAILS=
