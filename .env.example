# --- Google OAuth client (Google Cloud Console > Credentials) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Local dev: http://localhost:3000
# Production: https://<your-app>.vercel.app
AUTH_URL=http://localhost:3000

# --- Access control ---
# Comma-separated allowlist. Anyone not listed is refused after Google sign-in.
# Leave empty to allow any account that gets past Google's consent screen.
ALLOWED_EMAILS=

# --- Target spreadsheet ---
# The sheet the app writes to. Skips the manual "paste a link" step.
SHEET_URL=

# Only build the form from the first N header columns. Leave empty to use
# every column in row 1. Set this if the sheet has summary/pivot columns
# (monthly totals, per-person breakdowns) to the right of the data columns.
SHEET_FIELD_LIMIT=

# --- Repayments page (/loan) ---
# Full link or ID of the repayment spreadsheet. Required for that page.
LOAN_SHEET_URL=
# Tab holding Date / Description / Amount rows. Defaults to "Mou to Sunny".
LOAN_TAB=

# --- Sanchaypatro page (/sanchaypatro, read-only) ---
# Full link or ID of the spreadsheet with tabs: Total, Mou, Sunny. Required for that page.
SANCHAY_SHEET_URL=

# --- Other page (/other, private expenses stored in Turso) ---
# The only account that sees the Other menu. Leave empty to hide it from everyone.
OTHER_EMAIL=
# Whose rows in the expense sheet count towards the monthly total. Defaults to "Mou".
OTHER_PERSON=
# Turso database (turso db show <name> --url / turso db tokens create <name>).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
